# Valores públicos do Supabase usados pelo navegador. Nunca coloque chaves secretas aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# Variáveis disponíveis somente no ambiente do servidor.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Configure somente no gerenciador de segredos da hospedagem. Nunca use prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUBSTITUA
